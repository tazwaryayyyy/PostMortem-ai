# PostMortem.ai — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── Required ────────────────────────────────────────────────
# Groq API key — used by all text agents (llama, qwen, compound-beta)
# Get yours at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini API key — used ONLY by VisionAgent for screenshot analysis
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── Optional ─────────────────────────────────────────────────
# Max concurrent investigations served simultaneously (default: 10)
MAX_CONCURRENT_INVESTIGATIONS=10

# SQLite database file path (default: investigations.db in project root)
DB_PATH=investigations.db

# Application environment (development | production)
ENVIRONMENT=development

# Set to "true" on Vultr VMs to include instance metadata in /health
VULTR_DEPLOYMENT=false
