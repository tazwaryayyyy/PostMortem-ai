# PostMortem.ai — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── Required ────────────────────────────────────────────────
# Groq API key — fallback text inference when Vultr is not configured
# Get yours at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini API key — VisionAgent (screenshots) + CriticAgent (adversarial reasoning)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ── Vultr Serverless Inference (primary LLM provider) ────────
# Enables Vultr as the primary inference backend for all text agents.
# When set, Groq is used only as fallback.
# Get your key at: https://my.vultr.com/ai
VULTR_API_KEY=your-vultr-api-key-here

# Vultr Serverless Inference endpoint (default shown — override only if needed)
VULTR_INFERENCE_URL=https://api.vultrinference.com/v1/chat/completions

# ── Optional ─────────────────────────────────────────────────
# Max concurrent investigations served simultaneously (default: 10)
MAX_CONCURRENT_INVESTIGATIONS=10

# SQLite database file path (default: investigations.db in project root)
DB_PATH=investigations.db

# Application environment (development | production)
ENVIRONMENT=development

# Set to "true" on Vultr VMs to include instance metadata in /health
VULTR_DEPLOYMENT=false
